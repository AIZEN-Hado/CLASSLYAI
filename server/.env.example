# Neon development branch. Use the pooled URL for app traffic.
DATABASE_URL=postgresql://app_role:password@your-project-pooler.region.aws.neon.tech/classlyai?sslmode=verify-full

# Use the direct URL and the migration role for schema changes.
DATABASE_URL_DIRECT=postgresql://migration_role:password@your-project.region.aws.neon.tech/classlyai?sslmode=verify-full

# Use three distinct passwords of at least 12 characters for the seed command.
CLASSLYAI_DEMO_INSTRUCTOR_PASSWORD=
CLASSLYAI_DEMO_STUDENT_A_PASSWORD=
CLASSLYAI_DEMO_STUDENT_B_PASSWORD=

# Default origin for the built app. Use http://localhost:5173 for the Vite dev server.
CLASSLYAI_ORIGIN=http://localhost:5001

# Leave the key empty for the deterministic demo, or set a live OpenAI key.
CLASSLYAI_OPENAI_API_KEY=
# CLASSLYAI_AI_MODE=fixture
# CLASSLYAI_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# CLASSLYAI_OPENAI_ANSWER_MODEL=gpt-4.1-nano
